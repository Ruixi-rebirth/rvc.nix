+def validated_gpu_devices(value, field_name, allow_duplicates=True):
+    """Parse a WebUI GPU field and reject devices unavailable to this backend."""
+    text = str(value or "").strip()
+    if not text:
+        return []
+    if len(text) > 256:
+        raise ValueError(i18n("%s过长") % field_name)
+    tokens = text.split("-")
+    if len(tokens) > 64 or any(
+        re.fullmatch(r"[0-9]+", token) is None for token in tokens
+    ):
+        raise ValueError(i18n("%s格式无效，请使用以连字符分隔的GPU编号") % field_name)
+    devices = [int(token) for token in tokens]
+    unavailable = sorted(set(devices) - set(GPU_INDEX))
+    if unavailable:
+        available = "-".join(str(device) for device in sorted(GPU_INDEX))
+        raise ValueError(
+            i18n("%s包含不可用的GPU编号：%s；可用编号：%s")
+            % (
+                field_name,
+                "-".join(str(device) for device in unavailable),
+                available or i18n("无"),
+            )
+        )
+    if not allow_duplicates and len(devices) != len(set(devices)):
+        raise ValueError(i18n("%s不能包含重复的GPU编号") % field_name)
+    return [str(device) for device in devices]
+
+
+def start_train_process(state, argv):
+    if isinstance(argv, (str, bytes)) or not isinstance(argv, (list, tuple)):
+        raise TypeError("training subprocess arguments must be a list or tuple")
+    argv = [os.fspath(argument) for argument in argv]
+    if not argv:
+        raise ValueError("training subprocess arguments must not be empty")
+    kwargs = {"shell": False, "cwd": now_dir}
+    if len(argv) > 1 and argv[1].replace("\\", "/") == "train/train.py":
         training_env = os.environ.copy()
         training_env["RVC_CUDA_GRAPH"] = "0"
         kwargs["env"] = training_env
